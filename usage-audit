#!/usr/bin/env python3
import argparse
import datetime as dt
import json
import statistics
import subprocess
from collections import Counter
from pathlib import Path


def timestamp(value):
    if not value:
        return None
    try:
        return dt.datetime.fromisoformat(value.replace("Z", "+00:00"))
    except (TypeError, ValueError):
        return None


def byte_size(value):
    if isinstance(value, str):
        return len(value.encode("utf-8"))
    return len(json.dumps(value, ensure_ascii=False).encode("utf-8"))


def records(path):
    try:
        with path.open(encoding="utf-8") as stream:
            for line in stream:
                try:
                    yield json.loads(line)
                except json.JSONDecodeError:
                    continue
    except (OSError, UnicodeError):
        return


def percentile(values, fraction):
    if not values:
        return 0
    ordered = sorted(values)
    return ordered[min(len(ordered) - 1, int((len(ordered) - 1) * fraction))]


def summarize(provider, path, session_id, cwd, requests, prompt_sizes, tool_sizes, handoff_sizes, compactions, latest_model):
    if not requests and not prompt_sizes and not tool_sizes:
        return None
    usages = [entry[1] for entry in requests.values()]
    contexts = [usage["context"] for usage in usages]
    dates = [entry[0] for entry in requests.values()]
    totals = {key: sum(usage[key] for usage in usages) for key in ("input", "cached", "written", "output")}
    return {
        "provider": provider,
        "session_id": session_id,
        "session": (path.stem[-8:] if "subagents" in path.parts else path.stem[:8]) if provider == "claude" else path.stem.rsplit("-", 1)[-1][:8],
        "subagent": "subagents" in path.parts,
        "cwd": cwd or "unknown",
        "requests": len(requests),
        "models": dict(Counter(entry[2] for entry in requests.values() if entry[2])),
        "efforts": dict(Counter(entry[3] for entry in requests.values() if entry[3])),
        "latest_model": latest_model,
        "first": min(dates).isoformat() if dates else None,
        "last": max(dates).isoformat() if dates else None,
        "median_context": int(statistics.median(contexts)) if contexts else 0,
        "p90_context": percentile(contexts, 0.9),
        "max_context": max(contexts, default=0),
        "totals": totals,
        "prompt_bytes": sum(prompt_sizes),
        "max_prompt_bytes": max(prompt_sizes, default=0),
        "tool_result_bytes": sum(tool_sizes),
        "max_tool_result_bytes": max(tool_sizes, default=0),
        "handoffs": len(handoff_sizes),
        "handoff_bytes": sum(handoff_sizes),
        "compactions": compactions,
    }


def claude_session(path, cutoff):
    requests = {}
    prompt_sizes = []
    tool_sizes = []
    handoffs = {}
    compactions = 0
    cwd = None
    latest_model = None
    for row in records(path):
        when = timestamp(row.get("timestamp"))
        if not when or when < cutoff:
            continue
        cwd = cwd or row.get("cwd")
        kind = row.get("type")
        if kind == "assistant":
            message = row.get("message") or {}
            usage = message.get("usage") or {}
            request_id = row.get("requestId") or message.get("id")
            if not request_id or not usage or message.get("model") == "<synthetic>":
                continue
            fresh = usage.get("input_tokens", 0) or 0
            cached = usage.get("cache_read_input_tokens", 0) or 0
            written = usage.get("cache_creation_input_tokens", 0) or 0
            model = message.get("model")
            requests[request_id] = (when, {"context": fresh + cached + written, "input": fresh, "cached": cached, "written": written, "output": usage.get("output_tokens", 0) or 0}, model, row.get("perTurnEffort") or row.get("effort"))
            latest_model = model
            for block in message.get("content") or []:
                if isinstance(block, dict) and block.get("type") == "tool_use" and block.get("name") == "SendMessage":
                    handoffs[block.get("id") or (request_id, len(handoffs))] = byte_size((block.get("input") or {}).get("message", ""))
        elif kind == "user":
            blocks = (row.get("message") or {}).get("content")
            if isinstance(blocks, str):
                prompt_sizes.append(byte_size(blocks))
            elif isinstance(blocks, list):
                for block in blocks:
                    if not isinstance(block, dict):
                        continue
                    if block.get("type") == "tool_result":
                        tool_sizes.append(byte_size(block.get("content", "")))
                    elif block.get("type") == "text":
                        prompt_sizes.append(byte_size(block.get("text", "")))
        elif kind == "system" and row.get("subtype") == "compact_boundary":
            compactions += 1
    session_id = path.parent.parent.name if "subagents" in path.parts else path.stem
    return summarize("claude", path, session_id, cwd, requests, prompt_sizes, tool_sizes, list(handoffs.values()), compactions, latest_model)


def codex_session(path, cutoff):
    requests = {}
    prompt_sizes = []
    tool_sizes = []
    handoff_sizes = []
    compactions = 0
    cwd = None
    settings_by_turn = {}
    latest_model = None
    session_id = None
    for row in records(path):
        payload = row.get("payload") or {}
        kind = row.get("type")
        if kind == "session_meta":
            session_id = payload.get("id") or payload.get("session_id") or session_id
            cwd = payload.get("cwd") or cwd
        elif kind == "turn_context":
            model = payload.get("model")
            if model:
                settings_by_turn[payload.get("turn_id")] = (model, payload.get("effort"))
                latest_model = model
            cwd = payload.get("cwd") or cwd
        when = timestamp(row.get("timestamp"))
        if not when or when < cutoff:
            continue
        if kind == "token_usage_record":
            usage = payload.get("usage") or {}
            response_id = payload.get("response_id")
            if not response_id or not usage:
                continue
            input_tokens = usage.get("input_tokens", 0) or 0
            cached = usage.get("cached_input_tokens", 0) or 0
            written = usage.get("cache_write_input_tokens", 0) or 0
            model, effort = settings_by_turn.get(payload.get("turn_id"), (latest_model, None))
            requests[response_id] = (when, {"context": input_tokens, "input": max(0, input_tokens - cached), "cached": cached, "written": written, "output": usage.get("output_tokens", 0) or 0}, model, effort)
        elif kind == "response_item":
            item_type = payload.get("type")
            if item_type == "custom_tool_call_output":
                tool_sizes.append(byte_size(payload.get("output", "")))
            elif item_type == "message" and payload.get("role") == "user":
                prompt_sizes.append(byte_size(payload.get("content", "")))
        elif kind == "event_msg" and payload.get("type") in ("context_compacted", "compaction"):
            compactions += 1
    return summarize("codex", path, session_id, cwd, requests, prompt_sizes, tool_sizes, handoff_sizes, compactions, latest_model)


def instruction_files(home):
    workspace_files = sorted((home / ".claude" / "workspaces").glob("*.md"))
    paths = [home / ".claude" / "CLAUDE.md", *workspace_files, home / ".codex" / "AGENTS.md"]
    return [{"path": str(path), "bytes": path.stat().st_size} for path in paths if path.is_file()]


def scan(home, cutoff, selected_provider="both"):
    sessions = []
    roots = [(home / ".claude" / "projects", "claude", claude_session), (home / ".codex" / "sessions", "codex", codex_session)]
    for root, provider, parse in roots:
        if selected_provider not in ("both", provider):
            continue
        if not root.is_dir():
            continue
        for path in root.rglob("*.jsonl"):
            try:
                if dt.datetime.fromtimestamp(path.stat().st_mtime, dt.timezone.utc) < cutoff:
                    continue
            except OSError:
                continue
            result = parse(path, cutoff)
            if result:
                sessions.append(result)
    return sessions


def herdr_result(*arguments):
    try:
        completed = subprocess.run(["herdr", *arguments], capture_output=True, text=True, timeout=10, check=True)
        return json.loads(completed.stdout)["result"]
    except (OSError, subprocess.SubprocessError, ValueError, KeyError) as error:
        raise RuntimeError("Herdr workspace metadata is unavailable") from error


def workspace_membership(name):
    workspaces = herdr_result("workspace", "list").get("workspaces", [])
    matches = [item for item in workspaces if item.get("workspace_id") == name or item.get("label", "").casefold() == name.casefold()]
    if len(matches) != 1:
        raise ValueError(f"expected one Herdr workspace named {name!r}; found {len(matches)}")
    workspace = matches[0]
    workspace_id = workspace["workspace_id"]
    tabs = {item["tab_id"]: item.get("label", item["tab_id"]) for item in herdr_result("tab", "list", "--workspace", workspace_id).get("tabs", [])}
    members = {}
    unresolved = []
    for pane in herdr_result("pane", "list", "--workspace", workspace_id).get("panes", []):
        agent = pane.get("agent")
        if agent not in ("claude", "codex"):
            continue
        tab = tabs.get(pane.get("tab_id"), pane.get("tab_id", "unknown"))
        identity = pane.get("agent_session") or {}
        if identity.get("kind") == "id" and identity.get("value"):
            members[(agent, identity["value"])] = tab
        else:
            unresolved.append({"tab": tab, "provider": agent, "pane_id": pane.get("pane_id"), "cwd": pane.get("cwd")})
    return {"id": workspace_id, "label": workspace.get("label", name), "tabs": list(tabs.values()), "members": members, "unresolved": unresolved}


def group_workspace(sessions, workspace, match_cwd=False):
    cwd_tabs = {}
    if match_cwd:
        for pane in workspace["unresolved"]:
            if pane["cwd"]:
                cwd_tabs.setdefault((pane["provider"], pane["cwd"]), set()).add(pane["tab"])
    grouped = []
    for session in sessions:
        tab = workspace["members"].get((session["provider"], session["session_id"]))
        if tab:
            grouped.append({**session, "tab": tab, "membership": "session ID"})
        elif match_cwd:
            candidates = cwd_tabs.get((session["provider"], session["cwd"]), set())
            if len(candidates) == 1:
                grouped.append({**session, "tab": next(iter(candidates)), "membership": "working directory"})
    return grouped


def format_count(value):
    return f"{value:,}"


def print_report(sessions, files, hours, top, selected_provider, workspace=None):
    title = "Claude + Codex" if selected_provider == "both" else selected_provider.capitalize()
    scope = f" in Herdr workspace {workspace['label']}" if workspace else ""
    print(f"Local {title} audit{scope}, last {hours:g} hours")
    print("Input is split into fresh, cached read, and cache write. Counts are API usage records, not subscription credits or five-hour quota percentages.")
    print("User-item and tool-result sizes are serialized UTF-8 bytes, not token counts; images and metadata may be included. No content is printed.\n")
    if workspace:
        print(f"WORKSPACE: {len(workspace['tabs'])} tabs, {len(sessions)} matched sessions, {sum(s['requests'] for s in sessions):,} responses")
        totals = {key: sum(s["totals"][key] for s in sessions) for key in ("input", "cached", "written", "output")}
        print("  fresh input {input:,} | cached read {cached:,} | cache write {written:,} | output {output:,}".format(**totals))
        print(f"  Claude SendMessage handoffs: {sum(s['handoffs'] for s in sessions):,}; message text {sum(s['handoff_bytes'] for s in sessions):,} B")
        for tab in workspace["tabs"]:
            group = [session for session in sessions if session["tab"] == tab]
            total = sum(sum(s["totals"][key] for key in ("input", "cached", "written")) for s in group)
            print(f"  {tab}: {len(group)} sessions, {sum(s['requests'] for s in group):,} responses, {total:,} input processed, {sum(s['handoffs'] for s in group):,} handoffs")
        if workspace["unresolved"]:
            labels = ", ".join(f"{item['tab']} ({item['provider']})" for item in workspace["unresolved"])
            print(f"  Panes without a Herdr session ID: {labels}")
        heuristic = sum(s["membership"] == "working directory" for s in sessions)
        if heuristic:
            print(f"  {heuristic} sessions included by working directory; these may include unrelated work from the same folder.")
        print("  Exact membership uses live Herdr session IDs; earlier sessions from the same tabs are not inferred.\n")
    for provider in ("claude", "codex"):
        if selected_provider not in ("both", provider):
            continue
        group = [session for session in sessions if session["provider"] == provider]
        print(f"{provider.upper()}: {len(group)} sessions, {sum(s['requests'] for s in group):,} responses")
        if not group:
            print()
            continue
        totals = {key: sum(s["totals"][key] for s in group) for key in ("input", "cached", "written", "output")}
        print("  fresh input {input:,} | cached read {cached:,} | cache write {written:,} | output {output:,}".format(**totals))
        print("  largest sessions by total input processed:")
        for session in sorted(group, key=lambda s: s["totals"]["input"] + s["totals"]["cached"] + s["totals"]["written"], reverse=True)[:top]:
            total = sum(session["totals"][key] for key in ("input", "cached", "written"))
            label = " subagent" if session["subagent"] else ""
            tab = f" [{session['tab']}, {session['membership']}]" if workspace else ""
            print(f"    {session['session']}{label}{tab}  {session['requests']} responses  input {format_count(total)}  median context {format_count(session['median_context'])}  p90 {format_count(session['p90_context'])}  max {format_count(session['max_context'])}")
            print(f"      {session['cwd']} | models {session['models']} | efforts {session['efforts']} | user item max {format_count(session['max_prompt_bytes'])} B | tool result max {format_count(session['max_tool_result_bytes'])} B | compactions {session['compactions']}")
        print()
    if files:
        print("Standing instruction file sizes (bytes on disk; actual injected content may differ):")
        for item in files:
            print(f"  {item['bytes']:,}  {item['path']}")
    print("\nInvestigate high median/p90 context, large user items or tool results, and costly model/effort choices. These signals do not prove the cause of quota use.")


def main():
    parser = argparse.ArgumentParser(description="Audit local Claude and Codex session usage without AI or network access.")
    parser.add_argument("--hours", type=float, default=5, help="lookback window in hours (default: 5)")
    parser.add_argument("--top", type=int, default=10, help="sessions shown per provider (default: 10)")
    parser.add_argument("--provider", choices=("both", "claude", "codex"), default="both", help="audit one provider or both (default: both)")
    parser.add_argument("--workspace", help="group live Herdr workspace tabs by exact session ID (label or workspace ID)")
    parser.add_argument("--match-cwd", action="store_true", help="also include sessions matching panes whose session ID Herdr does not report; may include unrelated work")
    parser.add_argument("--home", type=Path, default=Path.home(), help="home directory containing .claude and .codex")
    parser.add_argument("--json", action="store_true", help="machine-readable report")
    args = parser.parse_args()
    if args.hours <= 0 or args.top <= 0:
        parser.error("--hours and --top must be positive")
    if args.match_cwd and not args.workspace:
        parser.error("--match-cwd requires --workspace")
    cutoff = dt.datetime.now(dt.timezone.utc) - dt.timedelta(hours=args.hours)
    sessions = scan(args.home, cutoff, args.provider)
    workspace = None
    if args.workspace:
        try:
            workspace = workspace_membership(args.workspace)
        except (RuntimeError, ValueError) as error:
            parser.error(str(error))
        sessions = group_workspace(sessions, workspace, args.match_cwd)
        workspace = {key: value for key, value in workspace.items() if key != "members"}
    files = [item for item in instruction_files(args.home) if args.provider == "both" or f"/.{args.provider}/" in item["path"]]
    if args.json:
        print(json.dumps({"hours": args.hours, "provider": args.provider, "workspace": workspace, "sessions": sessions, "instruction_files": files}, indent=2))
    else:
        print_report(sessions, files, args.hours, args.top, args.provider, workspace)


if __name__ == "__main__":
    main()
